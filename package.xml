<?xml version="1.0"?>
<package format="3">
  <name>ros2_trace_viewer</name>
  <version>0.1.0</version>
  <description>Offline, browser-based callback timeline and statistics for ROS 2 LTTng traces.</description>
  <maintainer email="maik.knof@gmx.de">Maik Knof</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>ros2trace</exec_depend>
  <exec_depend>tracetools_analysis</exec_depend>
  <exec_depend>tracetools_read</exec_depend>
  <exec_depend>python3-babeltrace</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>composition</test_depend>
  <test_depend>demo_nodes_cpp</test_depend>
  <test_depend>python3-pyqt5</test_depend>
  <test_depend>python3-httpx</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pyqt5.qtwebengine</test_depend>
  <test_depend>xvfb</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
